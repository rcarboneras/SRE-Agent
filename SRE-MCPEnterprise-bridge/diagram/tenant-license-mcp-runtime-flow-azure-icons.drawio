<mxfile host="app.diagrams.net" modified="2026-07-07T00:00:00.000Z" agent="Microsoft Scout" version="24.7.17">
  <diagram name="Runtime interaction flow">
    <mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/> <mxCell id="1" parent="0"/> <mxCell id="title" value="Runtime interaction flow: SRE Agent to Tenant License Optimization MCP Bridge" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=23;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1150" height="40" as="geometry"/></mxCell> <mxCell id="subtitle" value="This diagram follows one user request from prompt to final response and identifies each solution component role at every step." style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=12;fontColor=#555555" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1100" height="30" as="geometry"/></mxCell> <mxCell id="lane-user" value="User / SRE operator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;fontFamily=Segoe UI;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="35" y="95" width="230" height="680" as="geometry"/></mxCell> <mxCell id="lane-agent" value="Azure SRE Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F8FF;strokeColor=#8AB4F8;fontFamily=Segoe UI;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="285" y="95" width="300" height="680" as="geometry"/></mxCell> <mxCell id="lane-bridge" value="Azure Container Apps MCP bridge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF7;strokeColor=#81C784;fontFamily=Segoe UI;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="605" y="95" width="330" height="680" as="geometry"/></mxCell> <mxCell id="lane-entra" value="Microsoft Entra ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF7FF;strokeColor=#B084CC;fontFamily=Segoe UI;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="955" y="95" width="255" height="680" as="geometry"/></mxCell> <mxCell id="lane-graph" value="Microsoft Graph / Tenant data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00796B;fontFamily=Segoe UI;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="1230" y="95" width="305" height="680" as="geometry"/></mxCell> <mxCell id="s1" value="<b>1. User asks question</b><br><font style=&quot;font-size:11px&quot;>Example: analyze tenant license consumption, inactive licensed users, and optimization recommendations.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="135" width="190" height="88" as="geometry"/></mxCell> <mxCell id="s1-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="67" y="160.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s2" value="<b>2. Agent interprets intent</b><br><font style=&quot;font-size:11px&quot;>SRE Agent decides the request needs external MCP tools from license-optimization-mcp.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="305" y="135" width="260" height="88" as="geometry"/></mxCell> <mxCell id="s2-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="317" y="160.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s3" value="<b>3. Connector selects tool</b><br><font style=&quot;font-size:11px&quot;>MCP connector chooses a tool such as generate_license_optimization_recommendations or microsoft_graph_get.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="305" y="255" width="260" height="92" as="geometry"/></mxCell> <mxCell id="s3-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="317" y="282.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s4" value="<b>4. Managed identity token</b><br><font style=&quot;font-size:11px&quot;>SRE Agent managed identity requests an Entra token for api://&lt;bridge-app-id&gt;/.default.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="305" y="375" width="260" height="92" as="geometry"/></mxCell> <mxCell id="s4-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="317" y="402.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s5" value="<b>5. Token issued</b><br><font style=&quot;font-size:11px&quot;>Entra validates the SRE Agent managed identity and app-role assignment, then issues the JWT.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="975" y="375" width="215" height="92" as="geometry"/></mxCell> <mxCell id="s5-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="987" y="402.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s6" value="<b>6. MCP request received</b><br><font style=&quot;font-size:11px&quot;>Container App receives HTTPS POST /mcp with Authorization: Bearer &lt;JWT&gt;.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="625" y="255" width="290" height="92" as="geometry"/></mxCell> <mxCell id="s6-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="637" y="282.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s7" value="<b>7. Bridge validates JWT</b><br><font style=&quot;font-size:11px&quot;>Node.js bridge validates signature, issuer, audience, and allowed caller client ID.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="625" y="375" width="290" height="92" as="geometry"/></mxCell> <mxCell id="s7-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="637" y="402.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s8" value="<b>8. Bridge gets Graph token</b><br><font style=&quot;font-size:11px&quot;>Bridge user-assigned managed identity obtains app-only Microsoft Graph token.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="625" y="495" width="290" height="92" as="geometry"/></mxCell> <mxCell id="s8-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="637" y="522.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s9" value="<b>9. Read Graph data</b><br><font style=&quot;font-size:11px&quot;>Bridge calls read-only endpoints: /subscribedSkUs, /users, /licenseDetails, /groups, /applications, /auditLogs.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00796B;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="255" width="265" height="92" as="geometry"/></mxCell> <mxCell id="s9-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1262" y="282.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s10" value="<b>10. Tenant data returned</b><br><font style=&quot;font-size:11px&quot;>Graph returns license inventory, assignments, sign-in activity, directory objects, and audit context.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="375" width="265" height="92" as="geometry"/></mxCell> <mxCell id="s10-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1262" y="402.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s11" value="<b>11. MCP result shaped</b><br><font style=&quot;font-size:11px&quot;>Bridge calculates utilization, unassigned licenses, inactive licensed users, and recommendations as JSON/text MCP content.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="625" y="615" width="290" height="92" as="geometry"/></mxCell> <mxCell id="s11-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="637" y="642.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s12" value="<b>12. Agent composes answer</b><br><font style=&quot;font-size:11px&quot;>SRE Agent summarizes findings, explains recommendations, and can correlate with other operational context.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="305" y="615" width="260" height="92" as="geometry"/></mxCell> <mxCell id="s12-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="317" y="642.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="s13" value="<b>13. Final response</b><br><font style=&quot;font-size:11px&quot;>User receives the license optimization report and next actions in the SRE Agent chat.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFA000;arcSize=10;spacingLeft=62;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="615" width="190" height="88" as="geometry"/></mxCell> <mxCell id="s13-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="67" y="640.0" width="38" height="38" as="geometry"/></mxCell> <mxCell id="e1" value="Prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e2" value="Tool planning" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e3" value="Needs auth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e4" value="Token request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=1;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e5" value="Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e6" value="Validate caller" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e7" value="Authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e8" value="Graph app-only token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e9" value="Read-only queries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e10" value="JSON responses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e11" value="MCP tool result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s11" target="s12"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e12" value="Natural language answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=0;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s12" target="s13"><mxGeometry relative="1" as="geometry"/></mxCell> <mxCell id="e13" value="JWKS / issuer / app role context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#424242;strokeWidth=2;dashed=1;fontFamily=Segoe UI;fontSize=11;" edge="1" parent="1" source="s7" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
