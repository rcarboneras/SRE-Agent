      <root>
        <mxCell id="0"/> <mxCell id="1" parent="0"/> <mxCell id="title" value="Tenant License Optimization MCP Bridge for Azure SRE Agent" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=24;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell> <mxCell id="zone-sre" value="Azure SRE Agent workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F8FF;strokeColor=#8AB4F8;fontFamily=Segoe UI;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="35" y="80" width="330" height="540" as="geometry"/></mxCell> <mxCell id="zone-azure" value="Customer Azure subscription / resource group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF7;strokeColor=#81C784;fontFamily=Segoe UI;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="395" y="80" width="510" height="640" as="geometry"/></mxCell> <mxCell id="zone-entra" value="Microsoft Entra ID / Microsoft Graph" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF7FF;strokeColor=#B084CC;fontFamily=Segoe UI;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="935" y="80" width="430" height="640" as="geometry"/></mxCell> <mxCell id="sre" value="<b>Azure SRE Agent</b><br><font style=&quot;font-size:11px&quot;>Investigates operational questions and invokes selected MCP tools from chat.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65" y="130" width="270" height="90" as="geometry"/></mxCell> <mxCell id="sre-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="79" y="154.0" width="42" height="42" as="geometry"/></mxCell> <mxCell id="connector" value="<b>MCP connector: license-optimization-mcp</b><br><font style=&quot;font-size:11px&quot;>Streamable-HTTP connector configured with managed identity auth and bridge token scope.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#0078D4;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65" y="245" width="270" height="92" as="geometry"/></mxCell> <mxCell id="connector-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="79" y="270.0" width="42" height="42" as="geometry"/></mxCell> <mxCell id="sremi" value="<b>SRE Agent managed identity</b><br><font style=&quot;font-size:11px&quot;>Caller identity that acquires an Entra token for the bridge API audience.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65" y="362" width="270" height="90" as="geometry"/></mxCell> <mxCell id="sremi-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="79" y="386.0" width="42" height="42" as="geometry"/></mxCell> <mxCell id="artifacts" value="<b>solutionFinal artifacts</b><br><font style=&quot;font-size:11px&quot;>Parameterized source, ARM template, scripts, docs, and diagrams used to recreate the solution.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#FBC02D;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65" y="480" width="270" height="100" as="geometry"/></mxCell> <mxCell id="artifacts-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="79" y="509.0" width="42" height="42" as="geometry"/></mxCell> <mxCell id="rg" value="<b>Resource group</b><br><font style=&quot;font-size:11px&quot;>Contains Container Apps, managed environment, user-assigned identity, and related resources.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F8E9;strokeColor=#689F38;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="425" y="130" width="430" height="80" as="geometry"/></mxCell> <mxCell id="rg-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="439" y="149.0" width="42" height="42" as="geometry"/></mxCell> <mxCell id="acr" value="<b>Azure Container Registry Basic</b><br><font style=&quot;font-size:11px&quot;>Stores the MCP bridge container image. Lowest-cost Basic SKU for small deployments.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#F57C00;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="425" y="235" width="210" height="105" as="geometry"/></mxCell> <mxCell id="acr-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="439" y="266.5" width="42" height="42" as="geometry"/></mxCell> <mxCell id="env" value="<b>Container Apps environment</b><br><font style=&quot;font-size:11px&quot;>Serverless runtime boundary for the bridge Container App in Consumption profile.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="655" y="235" width="200" height="105" as="geometry"/></mxCell> <mxCell id="env-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="669" y="266.5" width="42" height="42" as="geometry"/></mxCell> <mxCell id="app" value="<b>Azure Container App: MCP bridge</b><br><font style=&quot;font-size:11px&quot;>Node.js Streamable-HTTP MCP server. Validates JWTs and exposes read-only tenant/license tools.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="425" y="365" width="430" height="115" as="geometry"/></mxCell> <mxCell id="app-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="439" y="401.5" width="42" height="42" as="geometry"/></mxCell> <mxCell id="bridgeMi" value="<b>Bridge user-assigned managed identity</b><br><font style=&quot;font-size:11px&quot;>Pulls image from ACR and obtains app-only Microsoft Graph tokens.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="425" y="505" width="430" height="95" as="geometry"/></mxCell> <mxCell id="bridgeMi-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="439" y="531.5" width="42" height="42" as="geometry"/></mxCell> <mxCell id="appreg" value="<b>Bridge API app registration</b><br><font style=&quot;font-size:11px&quot;>Defines audience api://&lt;bridge-app-id&gt;, user_impersonation scope, and app role McpBridge.Access.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="965" y="130" width="360" height="95" as="geometry"/></mxCell> <mxCell id="appreg-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="979" y="156.5" width="42" height="42" as="geometry"/></mxCell> <mxCell id="enterprise" value="<b>Bridge enterprise application</b><br><font style=&quot;font-size:11px&quot;>Service principal that receives app role assignments from SRE Agent managed identities.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="965" y="250" width="360" height="90" as="geometry"/></mxCell> <mxCell id="enterprise-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="979" y="274.0" width="42" height="42" as="geometry"/></mxCell> <mxCell id="graph" value="<b>Microsoft Graph</b><br><font style=&quot;font-size:11px&quot;>Read-only API surface used for licenses, users, groups, applications, audits, and sign-ins.</font>" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00796B;arcSize=10;spacingLeft=72;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1"><mxGeometry x="965" y="365" width="360" height="100" as="geometry"/></mxCell> <mxCell id="graph-icon" value="" style="shape=image;html=1;image=data:image/svg+xml;base64,;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="979" y="394.0" width="42" height="42" as="geometry"/></mxCell> <mxCell id="licenses" value="<b>Tenant licenses</b><br><font style=