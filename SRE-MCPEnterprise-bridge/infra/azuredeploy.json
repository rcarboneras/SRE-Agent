{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Azure Container Apps deployment for the SRE Agent Tenant License Optimization MCP bridge. Uses Consumption, scale-to-zero, 0.25 vCPU, 0.5Gi memory, and user-assigned managed identity."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "cae-license-mcp-bridge"
    },
    "containerAppName": {
      "type": "string",
      "defaultValue": "ca-license-mcp-bridge"
    },
    "containerImage": {
      "type": "string"
    },
    "acrName": {
      "type": "string"
    },
    "managedIdentityName": {
      "type": "string",
      "defaultValue": "id-license-mcp-bridge"
    },
    "tenantId": {
      "type": "string"
    },
    "bridgeAudience": {
      "type": "string",
      "metadata": {
        "description": "Expected JWT audience, for example api://<bridge-app-client-id>."
      }
    },
    "allowedClientIds": {
      "type": "string",
      "metadata": {
        "description": "Comma-separated client IDs allowed to call the bridge, normally the SRE Agent managed identity client ID."
      }
    },
    "targetPort": {
      "type": "int",
      "defaultValue": 8080
    },
    "inactiveUserDays": {
      "type": "int",
      "defaultValue": 90
    },
    "cpu": {
      "type": "string",
      "defaultValue": "0.25",
      "allowedValues": [
        "0.25",
        "0.5",
        "0.75",
        "1",
        "1.25",
        "1.5",
        "1.75",
        "2"
      ]
    },
    "memory": {
      "type": "string",
      "defaultValue": "0.5Gi",
      "allowedValues": [
        "0.5Gi",
        "1Gi",
        "1.5Gi",
        "2Gi",
        "2.5Gi",
        "3Gi",
        "3.5Gi",
        "4Gi"
      ]
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 10
    }
  },
  "variables": {
    "acrId": "[resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName'))]",
    "containerAppEnvId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
    "userAssignedIdentityId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[parameters('managedIdentityName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('acrId'), variables('userAssignedIdentityId'), 'AcrPull')]",
      "scope": "[format('Microsoft.ContainerRegistry/registries/{0}', parameters('acrName'))]",
      "dependsOn": [
        "[variables('userAssignedIdentityId')]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",
        "principalId": "[reference(variables('userAssignedIdentityId'), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('environmentName')]",
      "location": "[parameters('location')]",
      "properties": {
        "zoneRedundant": false,
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ]
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[variables('userAssignedIdentityId')]": {}
        }
      },
      "dependsOn": [
        "[variables('containerAppEnvId')]",
        "[variables('userAssignedIdentityId')]",
        "[extensionResourceId(variables('acrId'), 'Microsoft.Authorization/roleAssignments', guid(variables('acrId'), variables('userAssignedIdentityId'), 'AcrPull'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[variables('containerAppEnvId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": "[parameters('targetPort')]",
            "transport": "auto",
            "allowInsecure": false
          },
          "registries": [
            {
              "server": "[reference(variables('acrId'), '2023-01-01-preview').loginServer]",
              "identity": "[variables('userAssignedIdentityId')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "mcp-bridge",
              "image": "[parameters('containerImage')]",
              "env": [
                {
                  "name": "TENANT_ID",
                  "value": "[parameters('tenantId')]"
                },
                {
                  "name": "BRIDGE_AUDIENCE",
                  "value": "[parameters('bridgeAudience')]"
                },
                {
                  "name": "ALLOWED_CLIENT_IDS",
                  "value": "[parameters('allowedClientIds')]"
                },
                {
                  "name": "INACTIVE_USER_DAYS",
                  "value": "[string(parameters('inactiveUserDays'))]"
                },
                {
                  "name": "PORT",
                  "value": "[string(parameters('targetPort'))]"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(variables('userAssignedIdentityId'), '2023-01-31').clientId]"
                }
              ],
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[parameters('memory')]"
              }
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http-low-cost",
                "http": {
                  "metadata": {
                    "concurrentRequests": "10"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "sreAgentConnectorUrl": {
      "type": "string",
      "value": "[format('https://{0}/mcp', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "healthUrl": {
      "type": "string",
      "value": "[format('https://{0}/health', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "bridgeManagedIdentityClientId": {
      "type": "string",
      "value": "[reference(variables('userAssignedIdentityId'), '2023-01-31').clientId]"
    },
    "bridgeManagedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(variables('userAssignedIdentityId'), '2023-01-31').principalId]"
    }
  }
}
